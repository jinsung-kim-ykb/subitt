# Supabase Public Client Config (Browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# VAPID Public Key for Web Push (Browser)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# -------------------------------------------------------------
# Below secrets must NOT be placed in browser environment.
# Set them only in Supabase Dashboard Secrets:
# -------------------------------------------------------------
# AI_PROVIDER=gemini # mock | claude | openai | gemini
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VAPID_PRIVATE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
